# CampusMate AI Environment Variables
FLASK_APP=backend/app.py
FLASK_ENV=development
SECRET_KEY=dev_secret_key_change_in_production_123456
DATABASE_PATH=backend/database/campusmate.db
PORT=5000
FRONTEND_URL=http://localhost:3000

# LLM Configuration (Amazon Bedrock)
LLM_PROVIDER=demo
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_REGION=us-east-1
# AWS credentials (required when LLM_PROVIDER=bedrock)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_SESSION_TOKEN=optional_session_token_if_using_temporary_creds

# MCP Server Configuration (Alexa+ Track)
MCP_PORT=8080
MCP_AUTH_TOKEN=dev_mcp_secret_token_12345

